{
  "name": "@ludika/mobile-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "default": "./src/theme/index.ts"
    },
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "default": "./src/lib/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "catalog:",
    "@hugeicons/react-native": "catalog:",
    "@ludika/config": "workspace:*",
    "@tanstack/react-form": "catalog:",
    "@types/react": "~19.2.18",
    "expo-haptics": "~57.0.1",
    "heroui-native": "^1.0.8",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "typescript": "^6.0.3",
    "uniwind": "^1.11.0",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@hugeicons/core-free-icons": "*",
    "@hugeicons/react-native": "*",
    "@tanstack/react-form": "^1.33.2",
    "expo-haptics": "*",
    "heroui-native": "^1.0.8",
    "react": ">=19.0.0",
    "react-native": ">=0.81.0",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-safe-area-context": ">=5.0.0",
    "uniwind": "^1.11.0",
    "zod": "^4.0.0"
  }
}
